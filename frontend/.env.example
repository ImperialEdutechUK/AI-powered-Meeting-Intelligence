# ActionBrief frontend configuration
#
# Copy to `.env.local` for local development. On Railway, set these under the
# service's Variables tab instead. All backend-only variables (DATABASE_URL,
# SESSION_SECRET, OPENROUTER_API_KEY, ...) live in backend/.env.example instead —
# the frontend never touches them.

# Internal origin of the backend service. In local dev this is the backend's
# `npm run dev` port; on Railway, its private networking URL.
BACKEND_URL=http://127.0.0.1:3001

# ─── Branding ────────────────────────────────────────────────────────────────

ORG_NAME=Imperial Learning
ORG_SHORT=IL

# Upload ceiling in megabytes — shown to the user before they pick a file. Must
# match backend/.env.example's MAX_UPLOAD_MB, which is what actually enforces it.
MAX_UPLOAD_MB=25
