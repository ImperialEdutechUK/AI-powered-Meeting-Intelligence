# ActionBrief frontend configuration
#
# The production frontend is a static export (S3 + CloudFront), so these are
# inlined into the JavaScript at BUILD time. Never put a secret in a
# NEXT_PUBLIC_* variable. All secrets live on the backend Lambda instead.

# Local development only: where `npm run dev` proxies /api/* to. In
# production CloudFront routes /api/* to the backend, so this is unused.
BACKEND_URL=http://127.0.0.1:3001

# ─── Branding ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_ORG_NAME=Imperial Edutech
NEXT_PUBLIC_ORG_SHORT=IL

# Upload ceiling in megabytes, shown to the user before they pick a file. Must
# match the backend's MAX_UPLOAD_MB, which is what actually enforces it. Lambda
# function URLs cap a request body at 6 MB, so keep this at 4 or below there.
NEXT_PUBLIC_MAX_UPLOAD_MB=4
