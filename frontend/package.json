{
  "name": "actionbrief-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ActionBrief frontend \u2014 the staff-facing UI, statically exported to S3 + CloudFront. Talks to the backend over /api/*.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
