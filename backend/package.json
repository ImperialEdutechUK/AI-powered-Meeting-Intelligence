{
  "name": "actionbrief-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ActionBrief backend — API, Postgres access, LLM orchestration, and PDF/Word export rendering.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "migrate": "node scripts/migrate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-ssm": "3.1146.0",
    "@fontsource-variable/inter": "5.3.0",
    "clsx": "2.1.1",
    "docx": "9.7.1",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "puppeteer-core": "25.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
