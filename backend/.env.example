# ActionBrief configuration
#
# Copy to `.env.local` for local development. On Railway, set these under the
# service's Variables tab instead.

# ─── Storage ─────────────────────────────────────────────────────────────────

# Rate-limit storage — set ONE of these, or neither for local development
# (falls back to an in-memory limiter).
#
# AWS (Lambda): a DynamoDB table, created by infra/template.yaml.
# RATE_LIMIT_TABLE=actionbrief-RateLimitTable-XXXX
#
# Railway: Postgres. Add the Postgres plugin and reference it:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/actionbrief

# AWS only: the secret CloudFront sends as `x-origin-verify`. When set, the
# backend refuses requests that do not carry it. Leave unset elsewhere.
# ORIGIN_VERIFY_SECRET=

# Set to true only for a managed Postgres that requires TLS. Railway's internal
# network does not.
DATABASE_SSL=false

# ─── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# The shared code every member of staff enters to use the app.
# Minimum 6 characters; pick something memorable but not guessable.
APP_PASSCODE=change-this-passcode

# Signing key for the session cookie. Minimum 32 characters.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# ─── Models ──────────────────────────────────────────────────────────────────

# Verified on openrouter.ai, 5 August 2026:
#   gpt-5.6-luna       1,050,000 ctx  $0.10 in / $0.60 out  per million tokens
#   gpt-5.6-luna-pro   1,050,000 ctx  $0.10 in / $0.60 out  per million tokens
OPENROUTER_MODEL_FAST=openai/gpt-5.6-luna
OPENROUTER_MODEL_DEEP=openai/gpt-5.6-luna-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution shown on your OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://actionbrief.up.railway.app
OPENROUTER_SITE_NAME=ActionBrief

# ─── Branding ────────────────────────────────────────────────────────────────

ORG_NAME=Imperial Edutech
ORG_SHORT=IL

# ─── Runtime ─────────────────────────────────────────────────────────────────

# Absolute origin the server can reach itself on. Leave unset in production —
# it defaults to http://127.0.0.1:$PORT, which is what the PDF renderer needs.
# APP_BASE_URL=http://127.0.0.1:3000

# Chromium executable for PDF export. The Docker image installs it here.
CHROMIUM_PATH=/usr/bin/chromium

# Session lifetime in hours (1–720).
SESSION_HOURS=72

# Upload ceiling in megabytes (1–100).
MAX_UPLOAD_MB=25

# Briefs a single IP may generate per hour.
RATE_LIMIT_PER_HOUR=40

# Chromium instances the PDF renderer may run at once. Each one peaks around
# 350-450MB; keep this low on a 1GB instance. Extra requests queue briefly
# rather than launching unbounded browsers.
PDF_MAX_CONCURRENT_RENDERS=2
