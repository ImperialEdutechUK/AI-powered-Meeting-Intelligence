# ActionBrief configuration
#
# Copy to `.env.local` for local development. On Railway, set these under the
# service's Variables tab instead.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. On Railway, add the Postgres plugin and reference it:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/actionbrief

# Set to true only for a managed Postgres that requires TLS. Railway's internal
# network does not.
DATABASE_SSL=false

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# The shared code every member of staff enters to use the app.
# Minimum 6 characters; pick something memorable but not guessable.
APP_PASSCODE=change-this-passcode

# Signing key for the session cookie. Minimum 32 characters.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# ─── Models ──────────────────────────────────────────────────────────────────

# Verified on openrouter.ai, 30 July 2026:
#   deepseek-v4-flash  1,048,576 ctx  $0.09 in / $0.18 out  per million tokens
#   deepseek-v4-pro    1,048,576 ctx  $0.435 in / $0.87 out per million tokens
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_DEEP=deepseek/deepseek-v4-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution shown on your OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://actionbrief.up.railway.app
OPENROUTER_SITE_NAME=ActionBrief

# ─── Branding ────────────────────────────────────────────────────────────────

ORG_NAME=Imperial Learning
ORG_SHORT=IL

# ─── Runtime ─────────────────────────────────────────────────────────────────

# Absolute origin the server can reach itself on. Leave unset in production —
# it defaults to http://127.0.0.1:$PORT, which is what the PDF renderer needs.
# APP_BASE_URL=http://127.0.0.1:3000

# Chromium executable for PDF export. The Docker image installs it here.
CHROMIUM_PATH=/usr/bin/chromium

# Session lifetime in hours (1–720).
SESSION_HOURS=72

# Upload ceiling in megabytes (1–100).
MAX_UPLOAD_MB=25

# Briefs a single IP may generate per hour.
RATE_LIMIT_PER_HOUR=40
