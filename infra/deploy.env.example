# ActionBrief AWS deployment settings.
#
# Copy to infra/deploy.env (gitignored), then run infra/deploy.sh. Nothing in
# this file is secret. Secrets go to SSM Parameter Store SecureStrings (free
# tier, KMS-encrypted) instead of Secrets Manager ($0.40/secret/month).

# ─── Where ───────────────────────────────────────────────────────────────────

AWS_REGION=eu-north-1
STACK_NAME=actionbrief

DOMAIN_NAME=meeting-notes.imperial.imet.lk
# Route 53 hosted zone ID for imperial.imet.lk:
#   aws route53 list-hosted-zones --query "HostedZones[?Name=='imperial.imet.lk.'].Id"
HOSTED_ZONE_ID=
# ACM certificate in us-east-1 covering the domain (the *.imperial.imet.lk wildcard):
#   aws acm list-certificates --region us-east-1
CERTIFICATE_ARN=

# ─── Secrets ─────────────────────────────────────────────────────────────────
#
# Do NOT put secrets in this file. They live only in SSM Parameter Store
# (KMS-encrypted SecureStrings under /$STACK_NAME/). Set or rotate one by
# passing it in the environment for a single run:
#
#   read -rs OPENROUTER_API_KEY && export OPENROUTER_API_KEY && infra/deploy.sh
#   read -rs APP_PASSCODE && export APP_PASSCODE && infra/deploy.sh
#
# SESSION_SECRET and ORIGIN_VERIFY_SECRET are generated on the first deploy.

# ─── Optional ────────────────────────────────────────────────────────────────

ORG_NAME="Imperial Edutech"
ORG_SHORT=IL
# Lambda function URLs cap request bodies at 6 MB; 4 MB leaves room for
# multipart framing. A 60-minute Teams .vtt is ~150 KB.
MAX_UPLOAD_MB=4
RATE_LIMIT_PER_HOUR=40
LAMBDA_MEMORY_MB=2048
PRICE_CLASS=PriceClass_200
